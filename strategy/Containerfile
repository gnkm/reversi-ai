FROM docker.io/library/python:3.12-slim-bookworm AS base
COPY --from=ghcr.io/astral-sh/uv:0.12.17 /uv /uvx /bin/

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    PATH="/app/.venv/bin:$PATH"

COPY strategy/pyproject.toml strategy/uv.lock ./
COPY strategy/src ./src
COPY models /models
COPY prompts /prompts

# editable のままにする。wheel 化すると Path(__file__).parents[4] が /data と /models と /prompts を外れる。

FROM base AS train
RUN uv sync --frozen --no-dev --group train

FROM base AS strategy
RUN uv sync --frozen --no-dev

CMD ["python", "-m", "reversi.api"]
